[
  {"name":"arithmetic-bit-test","dialect":"bash","command":"(( flags & 1 )) && echo on"},
  {"name":"arithmetic-comparison","dialect":"bash","command":"(( flags < 8 && flags > 0 )) && echo in-range"},
  {"name":"arithmetic-expansion","dialect":"bash","command":"printf '%s\\n' $(( (flags & 1) << 2 ))"},
  {"name":"arithmetic-base-literal","dialect":"bash","command":"(( 16#ff & 1 )) && echo on"},
  {"name":"conditional-comparison","dialect":"bash","command":"[[ first < second && third > runs/job-a/input.txt ]]"},
  {"name":"conditional-file-test","dialect":"bash","command":"[[ -f runs/job-a/input.txt ]] && echo present"},
  {"name":"conditional-bracket-pattern","dialect":"bash","command":"[[ name == [[]* ]] && echo bracket"},
  {"name":"guarded-cleanup","dialect":"bash","command":"if [ -f scratch.txt ]; then rm scratch.txt; fi"},
  {"name":"guarded-loop","dialect":"bash","command":"while [ -f pending.flag ]; do echo waiting; done"},
  {"name":"guarded-alternative","dialect":"bash","command":"if [ -f ready.flag ]; then echo ready; else echo waiting; fi"},
  {"name":"grouped-output","dialect":"bash","command":"{ printf '%s\\n' ready; }"},
  {"name":"quoted-ampersand-1","dialect":"bash","command":"printf '%s\\n' 'A & B 1'"},
