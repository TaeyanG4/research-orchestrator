  {"name":"quoted-heredoc-1","dialect":"bash","command":"cat <<'EOF'\n`literal` & result-1\nEOF"},
  {"name":"nested-bash-1","dialect":"bash","command":"bash -c 'worker --case 1 &'"},
  {"name":"cross-shell-1","dialect":"bash","command":"powershell -c \"Write-Output 'case-1 & value'\""},
