[
  {"name":"guarded-cleanup","dialect":"powershell","command":"if (Test-Path scratch.txt) { Remove-Item scratch.txt }"},
  {"name":"guarded-output","dialect":"powershell","command":"if (Test-Path ready.flag) { Write-Output ready } else { Write-Output waiting }"},
  {"name":"guarded-loop","dialect":"powershell","command":"foreach ($path in @('first.txt','second.txt')) { Write-Output $path }"},
  {"name":"guarded-switch","dialect":"powershell","command":"switch ($mode) { ready { Write-Output ready } default { Write-Output waiting } }"},
  {"name":"guarded-finally","dialect":"powershell","command":"try { Write-Output ready } finally { Write-Output done }"},
  {"name":"pipeline-output","dialect":"powershell","command":"Get-ChildItem scratch | ForEach-Object { Write-Output $_.Name }"},
  {"name":"array-literal-paths","dialect":"powershell","command":"Remove-Item -LiteralPath 'scratch.txt','archive.txt'"},
  {"name":"array-positional-paths","dialect":"powershell","command":"Remove-Item scratch.txt, archive.txt"},
  {"name":"array-content-paths","dialect":"powershell","command":"Set-Content -Path scratch.txt,archive.txt -Value ready"},
  {"name":"array-output","dialect":"powershell","command":"Write-Output first,second"},
  {"name":"quoted-comma-path","dialect":"powershell","command":"Remove-Item -LiteralPath 'scratch,old.txt'"},
  {"name":"here-string-literal-quotes","dialect":"powershell","command":"$text = @'\n'\nRemove-Item runs/job-a/input.txt\nworker &\n'@\nWrite-Output ready"},
